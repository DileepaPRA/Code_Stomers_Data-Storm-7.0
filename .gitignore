# ===========================================
# DataStorm 7.0 — Code_Stomers .gitignore
# ===========================================

# Ignore all data layer folders (local only)
bronze/
silver/
gold/
raw_extract/

# Ignore data files
*.csv
*.parquet
*.xlsx

# EXCEPTION: Allow final predictions output
!output/
!output/Code_Stomers_predictions.csv

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore Python cache
__pycache__/
*.pyc
*.pyo

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore zip files
*.zip
