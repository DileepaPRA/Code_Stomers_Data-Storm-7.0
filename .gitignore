# ===========================================
# DataStorm 7.0 — Code_Stomers .gitignore
# ===========================================

# Ignore all data folders (local only)
data/raw/
data/bronze/
data/silver/
data/gold/

# Ignore data files globally just in case
*.csv
*.parquet
*.xlsx
*.zip

# EXCEPTION: Allow final predictions output
!data/output/
!data/output/Code_Stomers_predictions.csv

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Ignore Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Ignore OS files
.DS_Store
Thumbs.db
